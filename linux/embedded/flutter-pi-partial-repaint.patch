+int compositor_present_window_surface(struct compositor *compositor) {
+    struct fl_layer_composition *composition;
+    struct render_surface *render_surface;
+    struct view_geometry geometry;
+    struct fl_layer *layer;
+    int ok;
+
+    ASSERT_NOT_NULL(compositor);
+
+    geometry = window_get_view_geometry(compositor->main_window);
+
+    // this will not increase the refcount on the surface.
+    render_surface = window_get_render_surface(compositor->main_window, VEC2I((int) geometry.view_size.x, (int) geometry.view_size.y));
+    if (render_surface == NULL) {
+        LOG_ERROR("Couldn't get the window's render surface.\n");
+        return EIO;
+    }
+
+    // Flutter drew into the window surface itself, so there is no backing store.
+    FlutterBackingStore fl_store = {
+        .struct_size = sizeof(FlutterBackingStore),
+        .did_update = true,
+    };
+
+    ok = render_surface_queue_present(render_surface, &fl_store);
+    if (ok != 0) {
+        return ok;
+    }
+
+    composition = fl_layer_composition_new(1);
+    if (composition == NULL) {
+        return ENOMEM;
+    }
+
+    layer = fl_layer_composition_peek_layer(composition, 0);
+    layer->surface = surface_ref(CAST_SURFACE(render_surface));
+    layer->props.is_aa_rect = true;
+    layer->props.aa_rect = AA_RECT_FROM_COORDS(0, 0, geometry.view_size.x, geometry.view_size.y);
+    layer->props.quad = get_quad(layer->props.aa_rect);
+    layer->props.opacity = 1.0;
+    layer->props.rotation = 0.0;
+    layer->props.n_clip_rects = 0;
+    layer->props.clip_rects = NULL;
+
+    // Like compositor_push_fl_layers: the frame is in the surface's buffers either way.
+    TRACER_BEGIN(compositor->tracer, "compositor_push_composition");
+    ok = compositor_push_composition(compositor, composition);
+    TRACER_END(compositor->tracer, "compositor_push_composition");
+    if (ok != 0) {
+        LOG_DEBUG("Couldn't show the window surface. window_push_composition: %s\n", strerror(ok));
+    }
+
+    fl_layer_composition_unref(composition);
+    return 0;
+}
