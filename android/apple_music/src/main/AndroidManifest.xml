<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The host tells the hub whether the device is online. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Sign-in goes through the Apple Music app, which the host looks for first. -->
    <queries>
        <package android:name="com.apple.android.music"/>
    </queries>
    <application>
        <!-- MusicKit gives this screen of its sign-in no theme, though it needs an AppCompat
             one, which Rune's is not. It gets the theme of MusicKit's other screens. -->
        <activity
            android:name="com.apple.android.sdk.authentication.SDKUriHandlerActivity"
            android:theme="@style/MusicKitAuthTheme"/>
    </application>
</manifest>
