+        passed_on = malloc(n_events * sizeof *passed_on);
+        if (passed_on != NULL) {
+            n_events = blank_filter_pointer_events(flutterpi, events, n_events, passed_on);
+            events = passed_on;
+        }
+        if (n_events == 0) {
+            free(passed_on);
+            return;
+        }
+    }
