@@ -0,0 +1,129 @@
+// Copyright 2014 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import 'package:flutter/material.dart';
+import 'package:flutter/foundation.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter/services.dart';
+
+class StubInputClient extends Fake implements TextInputClient {}
+
+class LocalRectControl with TextInputControl {
+  Rect? rect;
+  @override
+  void setComposingRect(Rect value) {
+    rect = value;
+  }
+}
+
+void main() {
+  testWidgets(
+    'Windows composing rectangle follows full editable transform',
+    (WidgetTester tester) async {
+      final custom = LocalRectControl();
+      TextInput.setInputControl(custom);
+      final controller = TextEditingController();
+      final focus = FocusNode();
+      var scale = 1.0;
+      var angle = 0.0;
+      late StateSetter rebuild;
+      await tester.pumpWidget(
+        MaterialApp(
+          home: StatefulBuilder(
+            builder: (context, setState) {
+              rebuild = setState;
+              return Scaffold(
+                body: Transform.rotate(
+                  angle: angle,
+                  child: Transform.scale(
+                    scale: scale,
+                    child: TextField(controller: controller, focusNode: focus),
+                  ),
+                ),
+              );
+            },
+          ),
+        ),
+      );
+      await tester.showKeyboard(find.byType(EditableText));
+      controller.value = const TextEditingValue(
+        text: 'nihao',
+        selection: TextSelection.collapsed(offset: 5),
+        composing: TextRange(start: 0, end: 5),
+      );
+      await tester.pump();
+      await tester.pump();
+      final state = tester.state<EditableTextState>(find.byType(EditableText));
+      final editable = state.renderEditable;
+      void verify() {
+        final call = tester.testTextInput.log.lastWhere(
+          (c) => c.method == 'TextInput.setMarkedTextRect',
+        );
+        final args = call.arguments as Map<dynamic, dynamic>;
+        final local = editable.getRectForComposingRange(controller.value.composing)!;
+        expect(custom.rect, local);
+        final transform = editable.getTransformTo(null);
+        final expected = MatrixUtils.transformRect(transform, local);
+        final sentOrigin = MatrixUtils.transformPoint(
+          transform,
+          Offset(args['x'] as double, args['y'] as double),
+        );
+        if (defaultTargetPlatform != TargetPlatform.windows) {
+          expect(args['x'] as double, closeTo(local.left, 0.001));
+          expect(args['y'] as double, closeTo(local.top, 0.001));
+          expect(args['width'] as double, closeTo(local.width, 0.001));
+          expect(args['height'] as double, closeTo(local.height, 0.001));
+          return;
+        }
+        expect(sentOrigin.dx, closeTo(expected.left, 0.001));
+        expect(sentOrigin.dy, closeTo(expected.top, 0.001));
+        expect(args['width'] as double, closeTo(expected.width, 0.001));
+        expect(args['height'] as double, closeTo(expected.height, 0.001));
+      }
+
+      verify();
+      tester.testTextInput.log.clear();
+      rebuild(() => scale = 2.0);
+      await tester.pump();
+      await tester.pump();
+      if (defaultTargetPlatform == TargetPlatform.windows) {
+        verify();
+      } else {
+        expect(
+          tester.testTextInput.log.where((c) => c.method == 'TextInput.setMarkedTextRect'),
+          isEmpty,
+        );
+      }
+      tester.testTextInput.log.clear();
+      rebuild(() => angle = 0.25);
+      await tester.pump();
+      await tester.pump();
+      if (defaultTargetPlatform == TargetPlatform.windows) verify();
+      expect(focus.hasFocus, isTrue);
+      expect(controller.value.composing, const TextRange(start: 0, end: 5));
+      await tester.pumpWidget(const SizedBox());
+      TextInput.restorePlatformInputControl();
+      controller.dispose();
+      focus.dispose();
+    },
+    variant: const TargetPlatformVariant(<TargetPlatform>{
+      TargetPlatform.windows,
+      TargetPlatform.linux,
+    }),
+  );
+  testWidgets('Windows preserves the invalid composing rectangle sentinel', (tester) async {
+    final connection = TextInput.attach(StubInputClient(), const TextInputConfiguration());
+    connection.setEditableSizeAndTransform(const Size(100, 100), Matrix4.diagonal3Values(2, 2, 1));
+    connection.setComposingRect(const Rect.fromLTWH(double.infinity, 0, 1, 1));
+    await tester.pump();
+    final args =
+        tester.testTextInput.log
+                .lastWhere((c) => c.method == 'TextInput.setMarkedTextRect')
+                .arguments
+            as Map<dynamic, dynamic>;
+    expect(args['width'], -1.0);
+    expect(args['height'], -1.0);
+    connection.close();
+  }, variant: const TargetPlatformVariant(<TargetPlatform>{TargetPlatform.windows}));
+}
