+// Windows' IMM bridge transforms the rectangle origin but not its extent.
+// Keep other TextInputControls' composing rectangles in local coordinates.
+Rect _windowsEngineComposingRect(Rect rect, Matrix4? transform) {
+  if (!rect.isFinite || rect.width < 0 || rect.height < 0 || transform == null) return rect;
+  final m = transform.storage;
+  if (!m.every((double value) => value.isFinite) || m[3] != 0 || m[7] != 0 || m[15] != 1) {
+    return rect;
+  }
+  final double determinant = m[0] * m[5] - m[4] * m[1];
+  if (!determinant.isFinite || determinant == 0) return rect;
+  final xs = <double>[];
+  final ys = <double>[];
+  for (final x in <double>[rect.left, rect.right]) {
+    for (final y in <double>[rect.top, rect.bottom]) {
+      xs.add(m[0] * x + m[4] * y + m[12]);
+      ys.add(m[1] * x + m[5] * y + m[13]);
+    }
+  }
+  final double left = xs.reduce(math.min);
+  final double right = xs.reduce(math.max);
+  final double top = ys.reduce(math.min);
+  final double bottom = ys.reduce(math.max);
+  final double dx = left - m[12];
+  final double dy = top - m[13];
+  final double originX = (m[5] * dx - m[4] * dy) / determinant;
+  final double originY = (-m[1] * dx + m[0] * dy) / determinant;
+  final Rect result = Rect.fromLTWH(originX, originY, right - left, bottom - top);
+  return result.isFinite ? result : rect;
+}
