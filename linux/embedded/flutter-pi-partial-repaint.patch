+
+static bool flutter_rect_is_empty(FlutterRect rect) {
+    return rect.right <= rect.left || rect.bottom <= rect.top;
+}
+
+static FlutterRect flutter_rect_union(FlutterRect a, FlutterRect b) {
+    if (flutter_rect_is_empty(a)) {
+        return b;
+    } else if (flutter_rect_is_empty(b)) {
+        return a;
+    }
+
+    return (FlutterRect){
+        .left = MIN2(a.left, b.left),
+        .top = MIN2(a.top, b.top),
+        .right = MAX2(a.right, b.right),
+        .bottom = MAX2(a.bottom, b.bottom),
+    };
+}
+
+static void damage_history_push(struct damage_history *history, const FlutterDamage *frame_damage) {
+    FlutterRect frame = { 0 };
+
+    for (size_t i = 0; i < frame_damage->num_rects; i++) {
+        frame = flutter_rect_union(frame, frame_damage->damage[i]);
+    }
+
+    memmove(history->frames + 1, history->frames, (ARRAY_SIZE(history->frames) - 1) * sizeof *history->frames);
+    history->frames[0] = frame;
+    if (history->n_frames < ARRAY_SIZE(history->frames)) {
+        history->n_frames++;
+    }
+}
+
+/// What changed since a buffer of this age was drawn, apart from the frame flutter is about to draw.
+static FlutterRect damage_history_since(const struct damage_history *history, EGLint buffer_age, FlutterRect whole_buffer) {
+    FlutterRect damage = { 0 };
+
+    // An age of 0 means the buffer's contents are undefined.
+    if (buffer_age <= 0 || (size_t) (buffer_age - 1) > history->n_frames) {
+        return whole_buffer;
+    }
+
+    for (EGLint i = 0; i < buffer_age - 1; i++) {
+        damage = flutter_rect_union(damage, history->frames[i]);
+    }
+
+    return damage;
+}
+
+/// Called on the raster thread before flutter draws into the window surface (--partial-repaint):
+/// tells flutter which part of the buffer it is about to draw into is out of date.
+static void on_populate_existing_damage(void *userdata, const intptr_t fbo_id, FlutterDamage *existing_damage) {
+    struct flutterpi *flutterpi;
+    EGLDisplay display;
+    EGLSurface surface;
+    EGLint age, width, height;
+
+    ASSERT_NOT_NULL(userdata);
+    ASSERT_NOT_NULL(existing_damage);
+    flutterpi = userdata;
+    (void) fbo_id;
+
+    display = gl_renderer_get_egl_display(flutterpi->gl_renderer);
+    surface = compositor_get_egl_surface(flutterpi->compositor);
+
+    existing_damage->struct_size = sizeof *existing_damage;
+
+    if (eglQuerySurface(display, surface, EGL_WIDTH, &width) != EGL_TRUE || eglQuerySurface(display, surface, EGL_HEIGHT, &height) != EGL_TRUE) {
+        // Flutter draws everything when it gets no damage.
+        existing_damage->num_rects = 0;
+        existing_damage->damage = NULL;
+        return;
+    }
+
+    if (eglQuerySurface(display, surface, EGL_BUFFER_AGE_EXT, &age) != EGL_TRUE) {
+        age = 0;
+    }
+
+    flutterpi->damage_history.existing = damage_history_since(
+        &flutterpi->damage_history,
+        age,
+        (FlutterRect){ .left = 0, .top = 0, .right = width, .bottom = height }
+    );
+
+    existing_damage->num_rects = 1;
+    existing_damage->damage = &flutterpi->damage_history.existing;
+}
+
+/// Called on the raster thread when flutter has drawn a frame into the window surface
+/// (--partial-repaint): shows it, and remembers what changed.
+static bool on_present_with_info(void *userdata, const FlutterPresentInfo *info) {
+    struct flutterpi *flutterpi;
+    int ok;
+
+    ASSERT_NOT_NULL(userdata);
+    ASSERT_NOT_NULL(info);
+    flutterpi = userdata;
+
+    ok = compositor_present_window_surface(flutterpi->compositor);
+    if (ok != 0) {
+        // The buffers may no longer hold what the history says, so the next frames draw everything.
+        flutterpi->damage_history.n_frames = 0;
+        return false;
+    }
+
+    damage_history_push(&flutterpi->damage_history, &info->frame_damage);
+    return true;
+}
