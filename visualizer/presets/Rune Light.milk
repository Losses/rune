per_frame_1=q1 = max(bass_att - 0.9, 0);
per_frame_2=q2 = treb_att;
per_frame_3=q3 = mid_att;
per_frame_4=q4 = 0.5 + 0.5*sin(time*0.045);
per_frame_5=q5 = min(pixelsx, pixelsy)/max(pixelsx, pixelsy);
per_frame_6=q6 = q5;
wave_0_per_frame1=t1 = 0.21 + 0.05*q1;
wave_0_per_point1=w = sin(sample*3.14159);
wave_0_per_point2=ang = sample*6.28318 + time*0.12;
wave_0_per_point3=rr = t1 + 0.05*value1*w;
wave_0_per_point4=x = 0.5 + rr*cos(ang)*q5;
wave_0_per_point5=y = 0.5 + rr*sin(ang)*q6;
wave_0_per_point6=h = 0.5 + 0.5*sin(ang*1.5 + time*0.4);
wave_0_per_point7=r = 0.95;
wave_0_per_point8=g = 0.12 + 0.40*h;
wave_0_per_point9=b = 0.55 - 0.45*h;
wave_0_per_point10=a = 0.55;
wave_1_per_frame1=t1 = 0.12 + 0.03*q1;
wave_1_per_point1=w = sin(sample*3.14159);
wave_1_per_point2=ang = 6.28318 - sample*6.28318 - time*0.18;
wave_1_per_point3=rr = t1 + 0.035*value2*w;
wave_1_per_point4=x = 0.5 + rr*cos(ang)*q5;
wave_1_per_point5=y = 0.5 + rr*sin(ang)*q6;
wave_1_per_point6=h = 0.5 + 0.5*sin(ang*2.0 - time*0.5);
wave_1_per_point7=r = 1.0;
wave_1_per_point8=g = 0.35 + 0.30*h;
wave_1_per_point9=b = 0.12;
wave_1_per_point10=a = 0.22;
shape_0_per_frame1=rad = 0.045 + 0.045*q1;
shape_0_per_frame2=a = 0.07 + 0.12*q1;
warp_1=`shader_body
warp_2=`{
warp_3=`  float ar = texsize.x*texsize.w;
warp_4=`  float2 p = (uv - 0.5)*float2(ar, 1);
warp_5=`  float t = time;
warp_6=`  float2 n = tex2D(sampler_noise_hq, p*0.35 + float2(t*0.010, -t*0.008)).xy - 0.5;
warp_7=`  float2 m = tex2D(sampler_noise_hq, p*0.9 + float2(-t*0.015, t*0.012)).yz - 0.5;
warp_8=`  float2 swirl = float2(-p.y, p.x)*(0.0018 + 0.0025*q3);
warp_9=`  float2 flow = (n*0.0045 + m*0.0015)*(1.0 + 1.5*q1) + swirl;
warp_10=`  float2 suv = uv + flow*float2(1.0/ar, 1.0);
warp_11=`  suv = 0.5 + (suv - 0.5)*(0.9965 - 0.006*q1);
warp_12=`  float3 prev = tex2D(sampler_main, suv).rgb;
warp_13=`  prev = lerp(prev, GetBlur1(suv), 0.22);
warp_14=`  float f = tex2D(sampler_noise_hq, p*0.22 + float2(t*0.006, t*0.004)).x;
warp_15=`  float3 haze = lerp(float3(0.55, 0.05, 0.40), float3(0.80, 0.30, 0.05), q4);
warp_16=`  ret = max(prev*0.968 - 0.0025, 0.0) + haze*pow(f, 5.0)*0.020*(1.0 + q1);
warp_17=`}
comp_1=`shader_body
comp_2=`{
comp_3=`  float ar = texsize.x*texsize.w;
comp_4=`  float2 p = (uv - 0.5)*float2(ar, 1);
comp_5=`  float3 c = tex2D(sampler_main, uv).rgb;
comp_6=`  float3 glow = GetBlur1(uv)*0.55 + GetBlur2(uv)*0.45;
comp_7=`  float3 col = c + glow*0.9;
comp_8=`  float x = 1.0 - exp(-dot(col, float3(0.30, 0.59, 0.11))*1.4);
comp_9=`  float3 paper = float3(0.975, 0.955, 0.965);
comp_10=`  float3 a1 = float3(0.97, 0.72, 0.86);
comp_11=`  float3 a2 = float3(0.84, 0.10, 0.50);
comp_12=`  float3 a3 = float3(0.93, 0.38, 0.06);
comp_13=`  float3 s1 = float3(0.82, 0.74, 0.97);
comp_14=`  float3 s2 = float3(0.48, 0.14, 0.82);
comp_15=`  float3 k1 = lerp(a1, s1, q4*0.6);
comp_16=`  float3 k2 = lerp(a2, s2, q4*0.6);
comp_17=`  float3 pal = lerp(paper, k1, saturate(x*3.0));
comp_18=`  pal = lerp(pal, k2, saturate(x*3.0 - 1.0));
comp_19=`  pal = lerp(pal, a3, saturate(x*3.0 - 2.0));
comp_20=`  pal = lerp(pal, paper*0.94, 0.30*saturate(dot(p, p)*0.9));
comp_21=`  ret = pal;
comp_22=`}
